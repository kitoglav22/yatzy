{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{5}$/) && newData.hasChildren(['state'])",
        "state": { ".validate": "newData.isString() && newData.val().length < 100000" },
        "on": { "$dev": { ".validate": "newData.isBoolean()" } },
        "$other": { ".validate": false }
      }
    },
    "arcade": {
      "$run": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "$run.matches(/^[a-z0-9]{1,12}-[a-z0-9]{1,12}$/) && newData.hasChildren(['uid', 'at', 'log'])",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "at": { ".validate": "newData.isNumber()" },
        "log": { ".validate": "newData.isString() && newData.val().length < 300000" },
        "$other": { ".validate": false }
      }
    },
    "req": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length < 4000"
      }
    },
    "pub": { ".read": "auth != null" }
  }
}
